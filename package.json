{
  "name": "dsh-discord",
  "version": "0.5.3",
  "description": "Discord read/search toolkit for DeepSeek Harness: pull the signed-in token straight from Edge/Chrome leveldb, then search messages, archive whole channels, read context, download attachments with card/plugin detection, and pick random verified cards or plugins — all read-only, no browser needed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "discord",
    "search",
    "archive",
    "read-only"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuyaomin248-stack/dsh-discord.git"
  },
  "bugs": {
    "url": "https://github.com/wuyaomin248-stack/dsh-discord/issues"
  },
  "homepage": "https://github.com/wuyaomin248-stack/dsh-discord#readme",
  "scripts": {
    "check": "node scripts/check.mjs",
    "link-deps": "node scripts/link-deps.mjs",
    "test:load": "node load-test.mjs",
    "test:smoke": "node smoke.mjs",
    "test:scenario": "node scenario.mjs",
    "test:format": "node verify-improve.mjs",
    "test:export": "node verify-export.mjs",
    "test:plugins": "node test-plugin-tools.mjs",
    "test:archive": "node test-archive.mjs",
    "test:050": "node test-050-tools.mjs",
    "test": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "optionalDependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  }
}
